{
  "manifest_version": 3,
  "name": "最佳拍档网页剪藏",
  "description": "把当前网页保存到最佳拍档的本地收件箱。",
  "version": "0.1.0",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "nativeMessaging"],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "保存到最佳拍档"
  },
  "options_page": "src/options.html"
}
